# Neon Postgres — https://console.neon.tech  (use the POOLED connection string)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Telegram — get from @BotFather with /newbot
TELEGRAM_BOT_TOKEN="123456789:AA..."

# Your own Telegram numeric user id — get it from @userinfobot
# The bot ignores every other chat. This is the whole auth model.
TELEGRAM_OWNER_ID="123456789"

# Random string. Telegram must send it back on every webhook call, and the
# cron endpoints require it as ?key=. Generate: openssl rand -hex 24
APP_SECRET="replace-me-with-32-random-hex-chars"

# Your deployed origin, no trailing slash. Used to register the webhook.
PUBLIC_URL="https://daily-page.vercel.app"

# IANA timezone. The logical day starts at 04:00 local, so a 1:00am
# lights-out still counts toward the day that just ended.
APP_TZ="Asia/Kolkata"
